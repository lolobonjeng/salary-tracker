<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31) backup at device-transfer rules. -->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="database"
            path="salary_tracker.db" />
        <include
            domain="sharedpref"
            path="salary_prefs.xml" />
        <include
            domain="file"
            path="proofs/" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="database"
            path="salary_tracker.db" />
        <include
            domain="sharedpref"
            path="salary_prefs.xml" />
        <include
            domain="file"
            path="proofs/" />
    </device-transfer>
</data-extraction-rules>
